# OpenAI-compatible chat completions. Leave the key blank to disable
# rewrite and tailor; the rest of Folio keeps working.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Stripe test-mode values. Leave blank until you create a $2.99/month price.
# Checkout explains which of these are missing instead of crashing.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Local app settings.
FOLIO_DATABASE_PATH=data/folio.db
FOLIO_COOKIE_SECURE=0
FOLIO_PUBLIC_URL=http://127.0.0.1:5173
FOLIO_STATIC_DIR=frontend/dist
